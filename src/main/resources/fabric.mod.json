{
  "schemaVersion": 1,
  "id": "vacuum",
  "version": "${version}",
  "name": "Vacuum",
  "description": "Performance optimization mod for Minecraft 1.21.4. Reduces FPS drops, caps chunk loading, and cuts client-side action latency.",
  "authors": [
    "VacuumDev"
  ],
  "contact": {
    "sources": "https://github.com/bedspvp-glitch/vacuum-mod"
  },
  "license": "MIT",
  "icon": "assets/vacuum/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.vacuum.VacuumMod"
    ],
    "client": [
      "dev.vacuum.client.VacuumClientMod"
    ],
    "modmenu": [
      "dev.vacuum.client.gui.VacuumModMenuIntegration"
    ]
  },
  "mixins": [
    "vacuum.mixins.json",
    {
      "config": "vacuum.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.4"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  }
}